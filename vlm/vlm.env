# Hugging Face model id to load in vLLM.
VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct

# Name exposed by the OpenAI-compatible API. Keep this equal to model_name in ROS config.
VLM_SERVED_MODEL_NAME=Qwen/Qwen3-VL-4B-Instruct

# ---------------------------------------------------------------------------
# Kimi (Moonshot) API alternative
# ---------------------------------------------------------------------------
# Set USE_KIMI=true in your shell or docker-compose override to route VLM
# calls to the Kimi cloud API instead of the local vLLM server.
# KIMI_API_KEY must be provided when USE_KIMI is enabled.
# KIMI_API_URL defaults to https://api.moonshot.ai/v1
# KIMI_MODEL defaults to kimi-k2.6
# ---------------------------------------------------------------------------
# USE_KIMI=false

# Optional: Google Gemini API credentials.
# Set USE_GEMINI=true in your shell or docker-compose override to route VLM
# calls to the Gemini API instead of the local server.
# GEMINI_API_KEY must be provided when USE_GEMINI is enabled.
# GEMINI_MODEL determines the Gemini model to use (default: gemini-2.5-pro).
# USE_GEMINI=false
# KIMI_API_KEY=
# KIMI_API_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2.6

# Set to false for text-only models.
VLM_ENABLE_MULTIMODAL=true

# API server settings.
VLM_PORT=8000
VLM_DTYPE=auto
VLM_MAX_MODEL_LEN=16384
VLM_GPU_MEMORY_UTILIZATION=0.70

# Allow one image per prompt for scene description requests.
VLM_MAX_IMAGES_PER_PROMPT=1
